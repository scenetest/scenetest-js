{
  "name": "@scenetest/receiver",
  "version": "0.12.0",
  "description": "Framework-agnostic receiver core for scenetest protocol events - a Hono app that accepts events and fans them out to sinks",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/receiver"
  },
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "protocol",
    "events",
    "receiver",
    "hono"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@scenetest/protocol": "workspace:*",
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
