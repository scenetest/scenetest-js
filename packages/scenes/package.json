{
  "name": "@scenecheck/scenes",
  "version": "0.1.0",
  "description": "CLI runner, actor DSL, and recorder for scenecheck scene specs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/scenes"
  },
  "keywords": ["testing", "e2e", "playwright", "cli", "assertions", "recorder"],
  "bin": {
    "scenecheck": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recorder": {
      "types": "./dist/recorder/index.d.ts",
      "import": "./dist/recorder/index.js"
    },
    "./recorder/auto": {
      "types": "./dist/recorder/auto.d.ts",
      "import": "./dist/recorder/auto.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@scenecheck/checks": "workspace:*",
    "playwright": "^1.40.0",
    "commander": "^12.0.0",
    "glob": "^10.3.10",
    "jiti": "^2.4.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
