{
  "name": "@scenecheck/checks-react",
  "version": "0.1.0",
  "description": "React bindings for scenecheck inline assertions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/checks-react"
  },
  "keywords": ["testing", "e2e", "playwright", "react", "assertions", "inline-assertions"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scenecheck/checks": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "typescript": "^5.3.3"
  }
}
