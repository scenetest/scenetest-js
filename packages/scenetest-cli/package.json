{
  "name": "@scenetest/cli",
  "version": "0.0.2",
  "description": "CLI tool for running scenetest scene specs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/scenetest-cli"
  },
  "keywords": ["testing", "e2e", "playwright", "cli", "assertions"],
  "bin": {
    "scenetest": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "commander": "^12.0.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
