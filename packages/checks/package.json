{
  "name": "@scenetest/checks",
  "version": "0.14.0",
  "description": "Inline assertions for end-to-end testing",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/checks"
  },
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "assertions",
    "inline-assertions",
    "tanstack-intent"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./panel": {
      "types": "./dist/panel/auto.d.ts",
      "import": "./dist/panel/auto.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skills:validate": "intent validate"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.0.41",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4",
    "@types/react": "^18.0.0",
    "react": "^18.3.0",
    "preact": "^10.22.0",
    "vue": "^3.5.0",
    "solid-js": "^1.9.11",
    "svelte": "^5.55.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "preact": "^10.0.0",
    "vue": "^3.3.0",
    "solid-js": "^1.8.0",
    "svelte": "^5.55.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
