{
  "name": "@scenetest/checks",
  "version": "0.11.0",
  "description": "Inline assertions for end-to-end testing",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/checks"
  },
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "assertions",
    "inline-assertions",
    "tanstack-intent"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skills:validate": "intent validate"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.0.41",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  }
}
