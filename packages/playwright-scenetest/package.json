{
  "name": "@scenetest/playwright",
  "version": "0.0.3",
  "description": "Playwright fixtures for scenetest inline assertions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/playwright-scenetest"
  },
  "keywords": ["testing", "e2e", "playwright", "assertions", "inline-assertions", "fixtures"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scenetest/core": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "typescript": "^5.3.3"
  }
}
