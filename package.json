{
  "name": "scenetest-monorepo",
  "version": "0.1",
  "private": false,
  "type": "module",
  "repository": "https://github.com/scenetest/scenetest-js.git",
  "author": "msnook.xyz",
  "scripts": {
    "build": "pnpm --filter @scenetest/core --filter @scenetest/cli build && pnpm -r build",
    "dev": "pnpm --filter @scenetest/vite-plugin build && pnpm --filter example-app-react dev",
    "docs": "pnpx serve docs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @scenetest/vite-plugin test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0"
}
