{
  "name": "vscode-scenecheck",
  "displayName": "Scenecheck",
  "description": "Syntax highlighting for Scenecheck scene specs (.spec.md)",
  "version": "0.1.0",
  "publisher": "scenecheck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenecheck/scenecheck-js"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "scenecheck",
    "e2e",
    "testing",
    "spec"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scenecheck-spec",
        "aliases": [
          "Scenecheck Spec",
          "scenecheck"
        ],
        "extensions": [
          ".spec.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scenecheck-spec",
        "scopeName": "source.scenecheck-spec",
        "path": "./syntaxes/scenecheck-spec.tmLanguage.json"
      }
    ]
  }
}
