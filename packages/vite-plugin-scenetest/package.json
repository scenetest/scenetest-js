{
  "name": "@mhsnook/vite-plugin-scenetest",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "scripts": {
    "build:dev-panel": "node scripts/bundle-dev-panel.mjs",
    "build": "pnpm run build:dev-panel && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run build:dev-panel && tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "magic-string": "^0.30.10",
    "@mhsnook/scenetest": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
