{
  "name": "@scenetest/solid",
  "version": "0.0.2",
  "description": "Solid bindings for scenetest inline assertions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/scenetest-solid"
  },
  "keywords": ["testing", "e2e", "playwright", "solid", "solidjs", "assertions", "inline-assertions"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scenetest/core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "solid-js": "^1.9.0"
  }
}
