{
  "name": "@scenetest/dashboard",
  "version": "0.11.0",
  "description": "Mountable Preact dashboard widget for scenetest — renders a live run into a shadow root, fed by a pluggable transport adapter",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenetest/scenetest-js",
    "directory": "packages/dashboard"
  },
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "dashboard",
    "preact",
    "widget"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collections": {
      "types": "./dist/collections/index.d.ts",
      "import": "./dist/collections/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@scenetest/protocol": "workspace:*",
    "@tanstack/db": "^0.6.0",
    "htm": "^3.1.1",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  }
}
